#include <iostream>
#include <string>
#include <vector>
#include <sstream>
#include <cctype>

std::string modifySentence(std::string sentence) {
    std::stringstream ss(sentence);
    std::vector<std::string> words;
    std::string word;
    
    // Split the sentence into individual words
    while (ss >> word) {
        words.push_back(word);
    }
    
    if (words.empty()) {
        return sentence;
    }
    
    // Clean trailing punctuation from the last word to check its starting letter accurately
    std::string lastWordClean = words.back();
    while (!lastWordClean.empty() && !std::isalpha(lastWordClean.back())) {
        lastWordClean.pop_back();
    }
    
    if (lastWordClean.empty()) {
        return sentence;
    }
    
    // Get the first letter of the last word (case-insensitive)
    char firstLetter = std::tolower(lastWordClean[0]);
    bool isVowel = (firstLetter == 'a' || firstLetter == 'e' || firstLetter == 'i' || 
                    firstLetter == 'o' || firstLetter == 'u');
    
    std::string result = "";
    
    if (isVowel) {
        // If it starts with a vowel, remove the first word
        for (size_t i = 1; i < words.size(); ++i) {
            result += words[i] + (i == words.size() - 1 ? "" : " ");
        }
    } else {
        // If it starts with a consonant, insert "definitely" before the last word
        words.insert(words.end() - 1, "definitely");
        for (size_t i = 0; i < words.size(); ++i) {
            result += words[i] + (i == words.size() - 1 ? "" : " ");
        }
    }
    
    return result;
}

int main() {
    // Example 1: Last word starts with a vowel ('input' starts with 'i')
    std::string input1 = "Always check your input.";
    std::cout << "Input:  \"" << input1 << "\"\n";
    std::cout << "Output: \"" << modifySentence(input1) << "\"\n\n";

    // Example 2: Last word starts with a consonant ('cool' starts with 'c')
    std::string input2 = "Data structures are cool.";
    std::cout << "Input:  \"" << input2 << "\"\n";
    std::cout << "Output: \"" << modifySentence(input2) << "\"\n";
    
    return 0;
}
